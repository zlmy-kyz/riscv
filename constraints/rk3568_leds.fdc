# RK3568_MES2L50H/MES2L100H manual v1.1, section 2.1.11 (PDF pages 18-19).
# LED fragment only. Import alongside the verified board DDR/clock constraints.
# All three LEDs are active high. Set IO standard/VCCIO from the actual bank
# supply and board revision; these attributes are intentionally not guessed.
define_attribute {p:led_clk_alive} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_clk_alive} {PAP_IO_LOC} {J16}
define_attribute {p:led_ddr_ready} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_ddr_ready} {PAP_IO_LOC} {M17}
define_attribute {p:led_selftest} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led_selftest} {PAP_IO_LOC} {K17}
