# PDS build outputs (keep RISCV.pds and all source constraints).
/compile/
/synthesize/
/device_map/
/place_route/
/generate_netlist/
/generate_bitstream/
/report_timing/
/report_power/
/log/
/logbackup/
*.pds.lock
/constraint_check/*.ccr

# Build outputs inside isolated PDS validation projects.
/sim/**/compile/
/sim/**/synthesize/
/sim/**/device_map/
/sim/**/place_route/
/sim/**/generate_netlist/
/sim/**/generate_bitstream/
/sim/**/report_timing/
/sim/**/report_power/
/sim/**/logbackup/

# ModelSim compiled libraries. Keep Tcl, TBs, file lists and IP sim_lib sources.
/sim/**/work/
/sim/**/*_work/
/ipcore/ddr3/sim/modelsim/work/
/ipcore/ddr3/sim/modelsim/*_work/
/ipcore/ddr3/sim/modelsim/sim/**/work/
/ipcore/ddr3/sim/modelsim/sim/**/*_work/

# Simulation executables, waveforms and console scratch output.
*.vvp
*.wlf
*.vcd
/sim/**/transcript
/sim/uart_mmio/*_console.log
/sim/uart_mmio/bus_regression_compile.log
/sim/uart_mmio/cpu_image/
