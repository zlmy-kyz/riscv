/difftest/build/
/tmp/
# Derived DDR model recreated by sim/compile_ddr3_physical_model.tcl.
/sim/ddr_physical_model/

# Python cache.
__pycache__/
*.pyc
*.pyo

# IP generation metadata; retain IDF, RTL and generated initialization sources.
/ipcore/**/.last_generated
/ipcore/**/generate.log
/MyCpu_test/**/ipcore/**/.last_generated
/MyCpu_test/**/ipcore/**/generate.log

# Root-level tool logs and inspected temporary output.
/pds.log
/run.log
/flow.log
/pne.log
/stdout.log
/stderr.log
/_final.txt
/_ls.txt
/_rom.txt
/data.wf

# Local development notes and experiments; retain files locally.
/.workbuddy/

# Board-focused GitHub repository; these materials remain available locally.
# Keep constraint_check/temp_constraint_file.fdc: it is the active PDS input.
/bug/
# Publish only the assembler and two memory models required by the UART CPU TB.
/difftest/*
!/difftest/golden/
/difftest/golden/*
!/difftest/golden/rvtool.py
!/difftest/model/
/difftest/model/*
!/difftest/model/inst_rom.v
!/difftest/model/data_ram.v
/constraints/
# Publish only the selected documents; keep other documentation local.
/doc/*
