#This is temp constraint file, used to record unsaved constraints, if there are some errors, please modify them through User Constraint Editor directly

#write timing table

# Board reference and generated DDR clocks.
# Adapted from the CURRENT ipcore/ddr3/pnr/ddr_test.fdc timing section.
# IP CLKIN_FREQ=125 MHz, PPLL IDIV=1/FDIV=12/ODIVPHY=2.
# IOCLKDIV: DIV_FACTOR=8, PHASE_SHIFT=2; preserve the vendor edge waveform.
# Existing IO attributes below are preserved; these clock constraints do not
# validate the board's IO voltage/standard or DDR PHY placement.
create_clock -name {ddr_ref_clk} [get_ports {ddr_ref_clk_p}] -period {8.000} -waveform {0.000 4.000}

create_generated_clock -name {rst_clk} -source [get_ports {ddr_ref_clk_p}] [get_pins {u_soc.u_ddr3.u_ddrphy_top.rst_clk_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {12} -divide_by {12}
create_generated_clock -name {ddrphy_sysclk} -source [get_ports {ddr_ref_clk_p}] [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_gpll/clkout0}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {12} -divide_by {16}
create_generated_clock -name {phy_dq_clk_0} -source [get_ports {ddr_ref_clk_p}] [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {12} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_0} -source [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].ddrphy_ppll/clkoutphy}] [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[0].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_0}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_0]
create_generated_clock -name {phy_dq_clk_1} -source [get_ports {ddr_ref_clk_p}] [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] -master_clock [get_clocks {ddr_ref_clk}] -multiply_by {12} -divide_by {2}
create_generated_clock -name {phy_dq_sysclk_1} -source [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].ddrphy_ppll/clkoutphy}] [get_pins {u_soc.u_ddr3.u_ddrphy_top.ddrphy_slice_top.i_dqs_bank[1].u_ddrphy_ioclkdiv/CLKDIVOUT}] -master_clock [get_clocks {phy_dq_clk_1}] -edges {5 13 21} -edge_shift {0 0 0}
set_multicycle_path 2 -from [get_clocks ddrphy_sysclk] -to [get_clocks phy_dq_sysclk_1]
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_0}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_0}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {ddrphy_sysclk}] -to [get_clocks {phy_dq_sysclk_1}] -setup -hold
set_clock_uncertainty {0.4} -from [get_clocks {phy_dq_sysclk_1}] -to [get_clocks {ddrphy_sysclk}] -setup -hold
# Same clock-group treatment as the generated IP example; free_clk is absent.
# Keep ddrphy_sysclk and the two phy_dq_sysclk clocks timed against each other.
set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ddr_ref_clk}]
set_clock_groups -name rst_clk -asynchronous -group [get_clocks {rst_clk}]
set_clock_groups -name phy_dq_clk_0 -asynchronous -group [get_clocks {phy_dq_clk_0}]
set_clock_groups -name phy_dq_clk_1 -asynchronous -group [get_clocks {phy_dq_clk_1}]



